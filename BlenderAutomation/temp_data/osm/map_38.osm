    <tag k="artwork_type" v="bust"/>
    <tag k="inscription" v="You can put me in jail, but you cannot give me narrower quarters than as a seaman I have always had. You cannot give me coarser food than I have always eaten. You cannot make me lonelier than I have always been."/>
