    <tag k="artist_name" v="Joanne Hammer"/>
    <tag k="classification" v="2-Dimensional"/>
    <tag k="date" v="2002"/>
    <tag k="description" v="imagery rooted in both our ancient heritage and folk traditions (of various persons) is meant to speak to a common humanity. Neither narrative nor hierarchical it is about harmony and balance."/>
