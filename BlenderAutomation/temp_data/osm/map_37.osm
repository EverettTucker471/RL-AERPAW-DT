    <tag k="artwork_type" v="sculpture"/>
    <tag k="date" v="2003"/>
    <tag k="description" v="The artwork is a collection of over 5,000 images of the people of Seattle. The images range from 1.5 to 4.5 in dimension. From a distance the images are seen as a repeating rhythmic pattern. From close range the images can be read as a peoples history"/>
