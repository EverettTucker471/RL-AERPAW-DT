  <node id="3211770128" lat="47.6040112" lon="-122.3290847" version="4" timestamp="2018-09-21T23:26:49Z" changeset="62813134" uid="447903" user="Glassman">
    <tag k="artist_name" v="Pam Beyette"/>
    <tag k="classification" v="Infrastructure"/>
    <tag k="date" v="2002"/>
    <tag k="description" v="The courts stairwell artwork is comprised of 24 bronze sculptures mounted in a grid pattern on a 26 ft. architectural plaster wall. Each object is a metaphor, symbol or rebus, a puzzle within a larger puzzles that challenges the viewer."/>
    <tag k="location" v="Seattle Justice Center, Seattle Municipal Court stairwell east wall between second and third floors,"/>
    <tag k="measurements" v="12' x 9' x 2' Sculpture (24 Objects) and 26' x 10' Architectural Plaster Wall"/>
    <tag k="media" v="Bronze LuminOre Cold Cast over Mixed Media"/>
    <tag k="name" v="Witness and Dilemma, Levels, Weights and Measures"/>
    <tag k="project" v="JUSTICE CENTER INTEGRATED ARTWORK"/>
    <tag k="sac_id" v="ESD03.042"/>
    <tag k="tourism" v="artwork"/>
  </node>
  <node id="3211770129" lat="47.6040818" lon="-122.3291874" version="4" timestamp="2018-09-21T23:26:49Z" changeset="62813134" uid="447903" user="Glassman">
    <tag k="artist_name" v="Deborah Lawrence"/>
    <tag k="classification" v="Mixed Media"/>
    <tag k="date" v="2002"/>
    <tag k="description" v="In this work the artist addresses the subject of community service in the name of justice. Each artwork portrays a Seattle citizen whose heroic example has made a positive and lasting impact on the community. '"/>
    <tag k="location" v="Seattle Justice Center, Seattle Municipal Court, 10th floor"/>
    <tag k="measurements" v="36 x 96 x 1 1/2"/>
    <tag k="media" v="Acrylic, collage and varnish on recycled tin trays"/>
    <tag k="name" v="Justice is Served: Celebrating the People Who Work For a Change"/>
    <tag k="project" v="JUSTICE CENTER SITED ARTWORK"/>
    <tag k="sac_id" v="ESD03.040.01-.07"/>
    <tag k="tourism" v="artwork"/>
  </node>
  <node id="3211770131" lat="47.6039619" lon="-122.3290900" version="4" timestamp="2018-09-21T23:26:48Z" changeset="62813134" uid="447903" user="Glassman">
    <tag k="artist_name" v="Marita Dingus"/>
    <tag k="artwork_type" v="sculpture"/>
    <tag k="date" v="2003"/>
    <tag k="description" v="A mixed-media Installation of leather and fabric forms strung together on wire. The artist took her inspiration from ornamental ironwork and pieced quilts."/>
